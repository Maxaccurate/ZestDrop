#include <windows.h>

#ifndef ZESTDROP_VERSION_MAJOR
#define ZESTDROP_VERSION_MAJOR 1
#define ZESTDROP_VERSION_MINOR 0
#define ZESTDROP_VERSION_PATCH 0
#define ZESTDROP_VERSION_TEXT "1.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION    ZESTDROP_VERSION_MAJOR,ZESTDROP_VERSION_MINOR,ZESTDROP_VERSION_PATCH,0
PRODUCTVERSION ZESTDROP_VERSION_MAJOR,ZESTDROP_VERSION_MINOR,ZESTDROP_VERSION_PATCH,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_DLL
FILESUBTYPE    0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "ZestDrop contributors"
            VALUE "FileDescription",  "ZestDrop File Explorer Context Menu"
            VALUE "FileVersion",      ZESTDROP_VERSION_TEXT
            VALUE "InternalName",     "ZestDropExplorerMenu"
            VALUE "LegalCopyright",   "MIT"
            VALUE "OriginalFilename", "ZestDropExplorerMenu.dll"
            VALUE "ProductName",      "ZestDrop"
            VALUE "ProductVersion",   ZESTDROP_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
